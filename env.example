# Пример файла переменных окружения
# Скопируйте этот файл в .env.local и заполните значения

# URL бэкенда
REACT_APP_API_URL=http://localhost:8000

# API ключ Яндекс.Карт
# Получите на https://developer.tech.yandex.ru/
REACT_APP_YANDEX_MAPS_API_KEY=your_yandex_maps_api_key_here

# API ключ DaData (опционально)
REACT_APP_DADATA_API_KEY=your_dadata_api_key_here
